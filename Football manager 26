function renderCup(){var cup=S.cups[S.userLeague];if(!cup)return'<div class="em">Кубок не активен</div>';var h='<div class="tt">'+CUPS[S.userLeague]+'</div>';if(cup.winner){h+='<div class="bracket"><span class="win">🏆 Победитель: '+cup.winner.name+'</span></div>';return h}h+='<div style="font-size:10px;color:#94a3b8;margin-bottom:6px">Стадия: '+cup.stageNames[cup.stage]+'</div>';var curRound=cup.rounds[cup.rounds.length-1];if(curRound){h+='<div class="tt">Пары</div>';curRound.slice(0,20).forEach(function(pair){var th=findTeam(pair[0]);var ta=findTeam(pair[1]);if(th&&ta)h+='<div class="bracket">'+badge(th,'s')+' '+th.name+' vs '+badge(ta,'s')+' '+ta.name+'</div>'})}return h}
function renderCL(){if(!S.cl)return'<div class="em">ЛЧ не активна</div>';var u=getUserTeam();var h='<div class="tt">🏆 Лига Чемпионов</div>';h+='<div style="font-size:10px;color:#94a3b8;margin-bottom:6px">Тур '+S.cl.round+'/8 · '+S.cl.stage+'</div>';if(u){var sorted=Object.keys(S.cl.table).map(function(k){return S.cl.table[k]}).sort(function(a,b){return b.pts-a.pts||(b.gf-b.ga)-(a.gf-a.ga)});var myPos=0;for(var i=0;i<sorted.length;i++)if(sorted[i].team.id===u.id)myPos=i+1;if(myPos>0){var zone=myPos<=8?'🟢 1/8':myPos<=16?'🟡 стыки':'🔴 вылет';h+='<div style="text-align:center;padding:8px;background:#0f172a;border-radius:6px;margin-bottom:6px"><div style="font-size:24px;font-weight:900;color:#4ade80">'+myPos+'</div><div style="font-size:10px">'+zone+'</div></div>'}}var sorted2=Object.keys(S.cl.table).map(function(k){return S.cl.table[k]}).sort(function(a,b){return b.pts-a.pts||(b.gf-b.ga)-(a.gf-a.ga)});h+='<table><thead><tr><th>#</th><th>Клуб</th><th>И</th><th>О</th></tr></thead><tbody>';sorted2.slice(0,20).forEach(function(x,i){var us=u&&x.team.id===u.id;h+='<tr style="'+(us?'font-weight:bold;background:#334155':'')+'"><td>'+(i+1)+'</td><td>'+badge(x.team,'s')+' '+x.team.name+'</td><td>'+x.pl+'</td><td><b>'+x.pts+'</b></td></tr>'});h+='</tbody></table>';if(S.cl.koHistory&&S.cl.koHistory.length){h+='<div class="tt">🏆 Плей-офф</div>';S.cl.koHistory.forEach(function(st){h+='<div style="font-size:10px;color:#facc15;margin-top:4px">'+st.stage+'</div>';st.pairs.forEach(function(p){h+='<div class="bracket">'+p.home+' vs '+p.away+' → <b style="color:#4ade80">'+p.winner+'</b></div>'})})}if(S.cl.winner)h+='<div class="tt">Победитель</div><div style="text-align:center;padding:12px;background:linear-gradient(135deg,#7c3aed,#4ade80);color:#000;border-radius:8px;font-weight:900">'+S.cl.winner.name+'</div>';return h}
function renderScorers(){var arr=S.leagues[S.userLeague];var all=[];arr.forEach(function(t){t.squad.forEach(function(p){if(p.seasonGoals>0)all.push({p:p,team:t})})});all.sort(function(a,b){return b.p.seasonGoals-a.p.seasonGoals});var h='<div class="tt">🎯 Бомбардиры</div>';if(!all.length)return h+'<div class="em">Сезон начался</div>';h+='<table><thead><tr><th>#</th><th>Игрок</th><th>Клуб</th><th>Г</th></tr></thead><tbody>';all.slice(0,30).forEach(function(x,i){var us=x.team.id===S.userTeamId;h+='<tr style="'+(us?'font-weight:bold;background:#334155':'')+'"><td>'+(i+1)+'</td><td>'+x.p.name+'</td><td>'+badge(x.team,'s')+' '+x.team.short+'</td><td><b style="color:#4ade80">'+x.p.seasonGoals+'</b></td></tr>'});h+='</tbody></table>';return h}
function renderAwards(){var h='<div class="tt">🏅 Награды</div>';if(!S.awards.length)return h+'<div class="em">Награды в конце сезона</div>';S.awards.slice().reverse().forEach(function(a){h+='<div style="background:#0f172a;border-radius:6px;padding:8px;margin-bottom:6px"><div style="color:#facc15;font-weight:900;margin-bottom:4px">'+a.season+'</div>';if(a.bdo)h+='<div style="font-size:11px;padding:3px 0">🌟 <b>ЗМ:</b> '+a.bdo.p.name+'</div>';if(a.topScorer)h+='<div style="font-size:11px;padding:3px 0">🎯 <b>Бомбардир:</b> '+a.topScorer.p.name+' ('+a.topScorer.p.seasonGoals+' г.)</div>';if(a.bestYoung)h+='<div style="font-size:11px;padding:3px 0">🌟 <b>Молодой:</b> '+a.bestYoung.p.name+'</div>';h+='</div>'});return h}
function renderHistory(){var h='<div class="tt">📜 История матчей</div>';if(!S.matchHistory||!S.matchHistory.length)return h+'<div class="em">Матчей ещё не было</div>';S.matchHistory.slice().reverse().slice(0,30).forEach(function(m){h+='<div class="bracket"><span style="color:#94a3b8;font-size:9px">'+m.season+' Тур '+m.round+'</span><br><b>'+m.home+'</b> '+m.gh+' : '+m.ga+' <b>'+m.away+'</b></div>'});return h}
function renderPreview(){var pm=S.previewMatch;if(!pm)return'';var h='<div class="tt">📋 Подготовка к матчу</div>';h+='<div style="display:flex;justify-content:space-between;align-items:center;background:#0f172a;padding:12px;border-radius:8px;margin-bottom:8px">';h+='<div style="text-align:center;flex:1">'+badge(pm.home)+'<div style="font-size:11px;font-weight:700;margin-top:4px">'+pm.home.name+'</div></div>';h+='<div style="font-size:14px;color:#facc15;font-weight:900">VS</div>';h+='<div style="text-align:center;flex:1">'+badge(pm.away)+'<div style="font-size:11px;font-weight:700;margin-top:4px">'+pm.away.name+'</div></div>';h+='</div>';h+='<div style="display:flex;gap:5px">';[['home',pm.home,pm.homeXI],['away',pm.away,pm.awayXI]].forEach(function(arr){h+='<div style="flex:1;background:#0f172a;padding:6px;border-radius:6px">';h+='<div style="font-size:10px;font-weight:700;color:#4ade80;margin-bottom:4px">'+arr[1].name.slice(0,14)+'</div>';arr[2].forEach(function(p){var pc={GK:'#f59e0b',DEF:'#3b82f6',MID:'#10b981',FWD:'#ef4444'}[p.pos]||'#666';h+='<div style="display:flex;justify-content:space-between;font-size:9px;padding:2px 0;border-bottom:1px solid #1e293b"><span style="color:'+pc+';font-weight:700">'+p.pos+'</span><span style="flex:1;margin-left:3px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+p.name+'</span><span style="font-weight:700;color:#facc15">'+p.rating+'</span></div>'});h+='</div>'});h+='</div>';h+='<button class="a" onclick="startMatch()" style="width:100%;padding:14px;margin-top:10px;font-size:14px">▶ НАЧАТЬ МАТЧ</button>';return h}
function renderLive(){var lm=S.liveMatch;if(!lm)return'';var h='<div style="text-align:center;background:linear-gradient(180deg,#1e293b,#0f172a);padding:12px;border-radius:8px;margin-bottom:8px">';h+='<div style="font-size:38px;font-weight:900;color:#4ade80">'+lm.minute+"'</div>";h+='<div style="font-size:10px;color:#94a3b8">'+(lm.minute<45?'1-й тайм':lm.minute===45?'ПЕРЕРЫВ':'2-й тайм')+'</div></div>';h+='<div style="display:flex;justify-content:space-between;align-items:center;background:#0f172a;padding:10px;border-radius:8px;margin-bottom:8px">';h+='<div style="text-align:center;flex:1">'+badge(lm.home)+'<div style="font-size:10px;font-weight:700;margin-top:4px">'+lm.home.name+'</div></div>';h+='<div style="font-size:30px;font-weight:900;color:#4ade80;padding:0 8px">'+lm.gh+' : '+lm.ga+'</div>';h+='<div style="text-align:center;flex:1">'+badge(lm.away)+'<div style="font-size:10px;font-weight:700;margin-top:4px">'+lm.away.name+'</div></div>';h+='</div>';h+='<div class="f" style="justify-content:center">';h+='<button onclick="setLiveSpeed(300)">🐢</button>';h+='<button onclick="setLiveSpeed(100)">▶</button>';h+='<button onclick="setLiveSpeed(30)">▶▶▶</button>';h+='<button onclick="skipLive()">⏭</button>';h+='</div>';h+='<div class="tt">📣 События</div>';if(!lm.events.length)h+='<div class="em">Матч идёт...</div>';else lm.events.slice().reverse().forEach(function(e){var ico=e.type==='yellow'?'🟨':e.type==='red'?'🟥':'⚽';h+='<div class="bracket"><span style="color:#facc15;font-weight:700">'+e.min+"'</span> "+ico+' <b>'+e.player+'</b> — '+e.team+'</div>'});return h}
function renderResult(){var r=S.lastMatchResult;if(!r)return'';var userWon=(r.home.id===S.userTeamId&&r.gh>r.ga)||(r.away.id===S.userTeamId&&r.ga>r.gh);var draw=r.gh===r.ga;var h='';if(draw)h+='<div style="text-align:center;padding:10px;background:#facc15;color:#000;border-radius:8px;margin-bottom:8px;font-weight:900;font-size:16px">🤝 НИЧЬЯ</div>';else if(userWon)h+='<div style="text-align:center;padding:10px;background:#4ade80;color:#000;border-radius:8px;margin-bottom:8px;font-weight:900;font-size:16px">🏆 ПОБЕДА!</div>';else h+='<div style="text-align:center;padding:10px;background:#ef4444;color:#fff;border-radius:8px;margin-bottom:8px;font-weight:900;font-size:16px">😢 ПОРАЖЕНИЕ</div>';h+='<div style="display:flex;justify-content:space-between;align-items:center;background:#0f172a;padding:12px;border-radius:8px;margin-bottom:8px">';h+='<div style="text-align:center;flex:1">'+badge(r.home)+'<div style="font-size:10px;font-weight:700;margin-top:4px">'+r.home.name+'</div></div>';h+='<div style="font-size:32px;font-weight:900;color:#4ade80;padding:0 8px">'+r.gh+' : '+r.ga+'</div>';h+='<div style="text-align:center;flex:1">'+badge(r.away)+'<div style="font-size:10px;font-weight:700;margin-top:4px">'+r.away.name+'</div></div>';h+='</div>';if(r.events&&r.events.length){h+='<div class="tt">📣 События</div>';r.events.forEach(function(e){var ico=e.type==='yellow'?'🟨':e.type==='red'?'🟥':'⚽';h+='<div class="bracket"><span style="color:#facc15;font-weight:700">'+e.min+"'</span> "+ico+' <b>'+e.player+'</b> — '+e.team+'</div>'})}h+='<button class="a" onclick="closeResult()" style="width:100%;padding:12px;margin-top:10px">✓ Продолжить</button>';return h}
function hideMenu(){document.getElementById('mainMenu').classList.add('hidden')}
function showMenu(){document.getElementById('mainMenu').classList.remove('hidden');document.getElementById('gameUI').classList.add('hidden')}
function showGame(){document.getElementById('mainMenu').classList.add('hidden');document.getElementById('gameUI').classList.remove('hidden')}
function startNewGame(){newGame();showGame()}
var SAVE_KEY='fm2627_saves_v2';
function getSaves(){try{return JSON.parse(localStorage.getItem(SAVE_KEY))||[]}catch(e){return[]}}
function saveGame(slot){var saves=getSaves();var u=getUserTeam();if(!u)return;var data={slot:slot,date:new Date().toISOString(),season:S.season,teamName:u.name,userLeague:S.userLeague,userTeamId:S.userTeamId,round:S.round,year:S.year,budget:u.budget,points:u.points,_gameDate:S.date.getTime()};var found=false;for(var i=0;i<saves.length;i++)if(saves[i].slot===slot){saves[i]=data;found=true;break}if(!found)saves.push(data);try{localStorage.setItem(SAVE_KEY,JSON.stringify(saves))}catch(e){}if(slot!=='auto')addNews('info','💾 Сохранено: '+u.name);render()}
function loadGame(slot){var saves=getSaves();var found=null;for(var i=0;i<saves.length;i++)if(saves[i].slot===slot)found=saves[i];if(!found){alert('Слот пуст');return}newGame();S.userLeague=found.userLeague;S.userTeamId=found.userTeamId;S.season=found.season;S.year=found.year||1;S.date=new Date(found._gameDate||Date.now());var arr=S.leagues[S.userLeague];if(arr){S.fixtures=mkSched(arr.map(function(x){return x.id}));buildSeasonDates(S.date.getFullYear());genMarket();setupCL();setupCups()}var u=getUserTeam();if(u&&found.budget)u.budget=found.budget;document.getElementById('tabs').style.display='flex';document.getElementById('actions').style.display='flex';showGame();addNews('info','📂 Загружено: '+found.teamName);render()}
function deleteSave(slot){var saves=getSaves().filter(function(s){return s.slot!==slot});try{localStorage.setItem(SAVE_KEY,JSON.stringify(saves))}catch(e){}showSaves()}
function showSaves(){hideMenu();document.getElementById('gameUI').classList.remove('hidden');document.getElementById('tabs').style.display='none';document.getElementById('actions').style.display='none';var saves=getSaves();var html='<div style="max-width:500px;margin:0 auto;padding:15px">';html+='<button class="bk" onclick="showMenu()" style="margin-bottom:10px">← Назад</button>';html+='<div class="tt">💾 СОХРАНЕНИЯ</div>';for(var i=1;i<=6;i++){var sv=null;for(var j=0;j<saves.length;j++)if(saves[j].slot===i||(i===6&&saves[j].slot==='auto'))sv=saves[j];var slotLabel=i===6?'🔄 Автосохранение':'Слот '+i;if(sv){var d=new Date(sv.date);html+='<div class="save-slot"><div class="sn">🔖 '+slotLabel+': '+sv.teamName+'</div>';html+='<div class="sd">'+sv.season+' · Тур '+sv.round+' · '+sv.points+' очк.</div>';html+='<div class="se">📅 '+d.toLocaleDateString()+' '+d.toLocaleTimeString()+'</div>';html+='<div style="display:flex;gap:6px;margin-top:8px"><button onclick="loadGame('+(i===6?"\'auto\'":i)+')" style="flex:1;padding:8px;background:#4ade80;color:#000;border:0;border-radius:4px;font-weight:700;cursor:pointer">📂 Загрузить</button>';if(i!==6)html+='<button onclick="deleteSave('+i+')" style="padding:8px 12px;background:#ef4444;color:#fff;border:0;border-radius:4px;font-weight:700;cursor:pointer">🗑</button>';html+='</div></div>'}else{html+='<div class="save-empty">'+slotLabel+' — пусто</div>'}}html+='</div>';document.getElementById('content').innerHTML=html}
function exitGame(){if(confirm('Выйти?')){showMenu()}}
document.querySelectorAll('.t').forEach(function(el){el.addEventListener('click',function(){if(S.userTeamId){tab=el.dataset.t;render()}})});
document.getElementById('bD').onclick=function(){if(S.simulating||S.negotiating||S.matchStage||!S.userTeamId)return;if(S.seasonOver&&!S.gameOver)endSeason();else advanceDay()};
document.getElementById('bSim').onclick=startSim;
document.getElementById('bStop').onclick=stopSim;
document.getElementById('bR').onclick=function(){if(!S.userTeamId){alert('Начни игру');return}var slot=prompt('Слот (1-5):','1');if(slot){slot=+slot;if(slot>=1&&slot<=5){saveGame(slot);alert('Сохранено')}}};
</script></body></html>
